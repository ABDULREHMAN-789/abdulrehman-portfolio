# Firebase Realtime Database URL
# Example: https://<your-firebase-project>-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SendGrid Email Service (Optional: used for contact form in /api/mail)
SENDGRID_API_KEY=
MAIL_FROM=
MAIL_TO=
